# The build context is the repository root (see api/Dockerfile), so exclude
# everything the image does not need. Keeping this tight matters: .env holds
# live database passwords and must never enter a layer.
.env
.env.*
!.env.example

.git
.github
.venv
venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
*.egg-info

web
node_modules
**/node_modules
**/dist
**/*.tsbuildinfo

docs
scripts
api/tests
ingest
.ingest_checkpoints
*.log
