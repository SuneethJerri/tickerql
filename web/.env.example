# Base origin of the analytics API. Copy to `web/.env.local` for local work.
#
# Leave it EMPTY for local development: vite.config.ts proxies /api to
# http://127.0.0.1:8000, so the browser talks to one origin and CORS never
# enters the picture.
#
# Set it in the Vercel dashboard for production, e.g.
#   VITE_API_BASE=https://sqlproj-api.onrender.com
#
# Vite inlines VITE_* variables at BUILD time. Changing this value in Vercel
# requires a redeploy to take effect; it is not read at runtime.
VITE_API_BASE=
