# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Owner connection. Runs migrations, ingestion writes, and view refreshes.
# Local dev (docker compose) default:
DATABASE_URL=postgresql://sqlproj_owner:localdev@localhost:5433/sqlproj
# On Neon use the DIRECT (non-pooled) endpoint here — REFRESH MATERIALIZED VIEW
# CONCURRENTLY and DDL must not go through the pgbouncer pooler.

# Read-only role used by the analytics endpoints.
DATABASE_URL_API=postgresql://sqlproj_api:changeme@localhost:5433/sqlproj

# SELECT-only role used exclusively by the text-to-SQL agent.
# This role has no write grants of any kind — see db/003_roles.sql.
DATABASE_URL_AGENT=postgresql://sqlproj_agent:changeme@localhost:5433/sqlproj

# Passwords assigned to the two restricted roles when `ingest migrate` runs.
SQLPROJ_API_PASSWORD=changeme
SQLPROJ_AGENT_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
# yfinance | tiingo | alphavantage  (yfinance needs no key and is verified working)
PRICE_SOURCE=yfinance
TIINGO_API_KEY=
ALPHAVANTAGE_API_KEY=
# Optional CoinGecko demo key. Raises rate limits; does NOT lift the 365-day
# historical cap — that requires a paid plan.
COINGECKO_API_KEY=

# ---------------------------------------------------------------------------
# Agent
# ---------------------------------------------------------------------------
# Your key. Without it /api/query returns 503 and everything else works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Optional: route through a gateway instead of api.anthropic.com --------
#
# Leave both blank for the direct Anthropic API.
#
# For OpenRouter, set:
#   ANTHROPIC_BASE_URL=https://openrouter.ai/api
#   ANTHROPIC_AUTH_STYLE=bearer
#   ANTHROPIC_API_KEY=<your OpenRouter key>
#   ANTHROPIC_MODEL=anthropic/claude-opus-5
#
# NOT ".../api/v1" — the Anthropic SDK appends "/v1/messages" itself, so a
# trailing /v1 double-paths into a 405. The config validator strips it anyway.
ANTHROPIC_BASE_URL=
# api_key -> x-api-key header (Anthropic).  bearer -> Authorization: Bearer (gateways).
ANTHROPIC_AUTH_STYLE=api_key

# Thinking depth: low | medium | high | xhigh | max. Leave EMPTY to omit the
# field entirely — `output_config` is Anthropic-specific and a gateway may
# reject it rather than ignore it.
AGENT_EFFORT=medium
